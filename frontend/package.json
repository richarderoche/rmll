{
  "name": "frontend",
  "private": true,
  "scripts": {
    "prebuild": "sanity typegen generate",
    "build": "next build",
    "predev": "npm run sanity:typegen",
    "dev": "next dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sanity:typegen": "cd ../studio && sanity schema extract --enforce-required-fields --force --path ../sanity.schema.json && cd ../frontend && sanity typegen generate",
    "start": "next start",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@gsap/react": "^2.1.2",
    "@next/env": "^16.3.8",
    "@next/third-parties": "^16.3.8",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "2.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "chroma-js": "^3.2.0",
    "classnames": "2.5.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "focus-trap-react": "^12.0.3",
    "gsap": "^3.15.0",
    "hamo": "^1.0.3",
    "hls.js": "^1.7.3",
    "lenis": "^1.3.26",
    "marqy": "^1.1.1",
    "next": "^16.3.8",
    "next-sanity": "^13.3.4",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "react-player": "^3.4.0",
    "sanity-image": "^1.3.0",
    "sharp": "^0.35.5",
    "sonner": "2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-easing-gradients": "^1.1.2",
    "vanilla-cookieconsent": "^3.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.8",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "latest",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.8",
    "sanity": "^6.17.0",
    "typescript": "^7.0.2"
  }
